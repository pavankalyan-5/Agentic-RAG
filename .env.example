COPILOT_DATABASE_URL=postgresql://copilot:copilot@localhost:5433/copilot
COPILOT_OPENAI_API_KEY=
# Fine-grained PAT, read-only access to public repos is enough for ingestion
COPILOT_GITHUB_TOKEN=
COPILOT_EMBEDDING_MODEL=text-embedding-3-small
COPILOT_EMBEDDING_DIM=1536
# Hard ceiling on total OpenAI spend (USD) across the whole project
COPILOT_BUDGET_USD=8.00
# owner/name of the repo to index, e.g. encode/httpx
COPILOT_DEMO_REPO=
COPILOT_SINCE_MONTHS=12
